# XAMPP defaults. Change these if your local MariaDB account uses a password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_lost_found
DB_USERNAME=root
DB_PASSWORD=
APP_TIMEZONE=UTC
APP_PORT=8081

# Docker Compose database credentials. Do not use these defaults outside local development.
MYSQL_ROOT_PASSWORD=local-root-change-me
MYSQL_DATABASE=smart_lost_found
MYSQL_USER=smart_lost_found_app
MYSQL_PASSWORD=local-app-change-me
